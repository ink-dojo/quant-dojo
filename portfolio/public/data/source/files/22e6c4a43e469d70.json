{"path": "research/qlib_baseline/.venv/lib/python3.11/site-packages/markupsafe/_native.py", "language": "python", "kind": "research", "lines": 8, "bytes": 210, "truncated": false, "content": "def _escape_inner(s: str, /) -> str:\n    return (\n        s.replace(\"&\", \"&amp;\")\n        .replace(\">\", \"&gt;\")\n        .replace(\"<\", \"&lt;\")\n        .replace(\"'\", \"&#39;\")\n        .replace('\"', \"&#34;\")\n    )\n"}